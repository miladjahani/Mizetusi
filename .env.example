ENVIRONMENT=production
ADMIN_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=
SQLITE_PATH=/data/zeus.db
PUBLIC_BASE_URL=
SESSION_TTL=86400
AUTO_RESET_INTERVAL=60

# Xray-core (normally no manual variables are required)
XRAY_ENABLED=true
XRAY_BINARY=/usr/local/bin/xray
XRAY_CONFIG=/data/xray.json
XRAY_VLESS_PORT=10001
XRAY_TROJAN_PORT=10002
XRAY_API_PORT=10085
XRAY_SYNC_INTERVAL=10
